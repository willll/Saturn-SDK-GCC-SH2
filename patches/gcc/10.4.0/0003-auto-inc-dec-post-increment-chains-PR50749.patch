+/* Return the location of the MEM in *LOC whose address is REG or
+   REG + CONST_INT, or NULL.  Like find_mem, refuse bit-field MEMs.  */
+
+static rtx *
+find_chain_mem (rtx *loc, rtx reg)
+{
+  rtx x = *loc;
+  enum rtx_code code = GET_CODE (x);
+  const char *const fmt = GET_RTX_FORMAT (code);
+
+  if (code == MEM)
+    {
+      rtx addr = XEXP (x, 0);
+      if (rtx_equal_p (addr, reg)
+	  || (GET_CODE (addr) == PLUS && rtx_equal_p (XEXP (addr, 0), reg)
+	      && CONST_INT_P (XEXP (addr, 1))))
+	return loc;
+    }
+  if (code == SIGN_EXTRACT || code == ZERO_EXTRACT)
+    return NULL;
+
+  for (int i = GET_RTX_LENGTH (code) - 1; i >= 0; i--)
+    if (fmt[i] == 'e')
+      {
+	if (rtx *r = find_chain_mem (&XEXP (x, i), reg))
+	  return r;
+      }
+    else if (fmt[i] == 'E')
+      for (int j = XVECLEN (x, i) - 1; j >= 0; j--)
+	if (rtx *r = find_chain_mem (&XVECEXP (x, i, j), reg))
+	  return r;
+  return NULL;
+}
+
+/* PR 50749.  The forms above pair one access with one increment, so
+
+     ... *(r + 0) ... *(r + s1) ... *(r + s1 + s2) ...  r = r + s1 + s2 + s3
+
+   (s1, s2, s3 being the access sizes, as ivopts and unrolling produce)
+   kept reg + disp addressing plus the add.  If ADD is such an increment
+   and the last uses of r before it are such a chain of MEMs, turn them
+   all into post-increments of r and delete ADD.  Return true on
+   success.  */
+
+static bool
+merge_inc_chain (rtx_insn *add, basic_block bb)
+{
+  rtx set = PATTERN (add);
+  if (!HAVE_POST_INCREMENT || GET_CODE (set) != SET)
+    return false;
+  rtx reg = SET_DEST (set), src = SET_SRC (set);
+  if (!REG_P (reg) || HARD_REGISTER_P (reg)
+      || GET_CODE (src) != PLUS || !rtx_equal_p (XEXP (src, 0), reg)
+      || !CONST_INT_P (XEXP (src, 1)) || INTVAL (XEXP (src, 1)) <= 0)
+    return false;
+
+  /* Walk back from ADD.  Every use of REG up to the start of the chain
+     would see the incremented value, so each must be a chain MEM.  END is
+     the offset the next earlier access must end at.  */
+  auto_vec<rtx_insn *, 8> insns;
+  auto_vec<rtx *, 8> locs;
+  HOST_WIDE_INT end = INTVAL (XEXP (src, 1));
+  /* shortcut: only look this many insns back, raise it if chains in big
+     blocks are missed.  */
+  int budget = 64;
+  for (rtx_insn *insn = PREV_INSN (add); end > 0; insn = PREV_INSN (insn))
+    {
+      if (insn == PREV_INSN (BB_HEAD (bb)) || --budget < 0)
+	return false;
+      if (!NONDEBUG_INSN_P (insn))
+	continue;
+      if (!reg_mentioned_p (reg, PATTERN (insn)))
+	{
+	  /* Such a note would describe the old value of REG.  */
+	  rtx note = find_reg_equal_equiv_note (insn);
+	  if (note && reg_mentioned_p (reg, XEXP (note, 0)))
+	    return false;
+	  continue;
+	}
+      if (CALL_P (insn)
+	  || (JUMP_P (insn) && targetm.lra_p ())
+	  || asm_noperands (PATTERN (insn)) >= 0
+	  || reg_set_p (reg, insn)
+	  || count_occurrences (PATTERN (insn), reg, 1) != 1)
+	return false;
+
+      rtx *loc = find_chain_mem (&PATTERN (insn), reg);
+      if (!loc)
+	return false;
+      rtx mem = *loc, addr = XEXP (mem, 0);
+      HOST_WIDE_INT size;
+      HOST_WIDE_INT off = GET_CODE (addr) == PLUS ? INTVAL (XEXP (addr, 1)) : 0;
+      if (!GET_MODE_SIZE (GET_MODE (mem)).is_constant (&size)
+	  || GET_MODE (reg) != targetm.addr_space.address_mode
+				 (MEM_ADDR_SPACE (mem))
+	  || off + size != end)
+	return false;
+      insns.safe_push (insn);
+      locs.safe_push (loc);
+      end = off;
+    }
+
+  /* A single access is the plain FORM_POST_INC case.  */
+  if (insns.length () < 2 || !dbg_cnt (auto_inc_dec))
+    return false;
+
+  bool speed = optimize_bb_for_speed_p (bb);
+  int old_cost = set_rtx_cost (set, speed), new_cost = 0;
+  for (unsigned i = 0; i < insns.length (); i++)
+    {
+      rtx mem = *locs[i];
+      rtx new_mem = replace_equiv_address_nv
+		      (mem, gen_rtx_POST_INC (GET_MODE (reg), reg));
+      old_cost += set_src_cost (mem, GET_MODE (mem), speed);
+      new_cost += set_src_cost (new_mem, GET_MODE (mem), speed);
+      validate_change (insns[i], locs[i], new_mem, true);
+    }
+  /* Stores have no post-increment on some targets (e.g. SH), so a chain
+     with a store fails validation as a whole.  */
+  if (new_cost > old_cost || !apply_change_group ())
+    {
+      cancel_changes (0);
+      if (dump_file)
+	fprintf (dump_file, "inc chain of %u at %d failed\n",
+		 insns.length (), INSN_UID (add));
+      return false;
+    }
+
+  /* INSNS is in reverse order.  Between access I and the next one (or
+     ADD), REG now holds its old value plus DONE, the end offset of
+     access I, so rebase debug uses there.  */
+  rtx_insn *next = add;
+  HOST_WIDE_INT done = INTVAL (XEXP (src, 1));
+  for (unsigned i = 0; i < insns.length (); i++)
+    {
+      rtx_insn *insn = insns[i];
+      add_reg_note (insn, REG_INC, reg);
+      if (rtx note = find_reg_equal_equiv_note (insn))
+	if (reg_mentioned_p (reg, XEXP (note, 0)))
+	  remove_note (insn, note);
+      if (MAY_HAVE_DEBUG_BIND_INSNS)
+	propagate_for_debug (insn, next, reg,
+			     plus_constant (GET_MODE (reg), reg, -done), bb);
+      done -= GET_MODE_SIZE (GET_MODE (*locs[i])).to_constant ();
+      next = insn;
+    }
+
+  if (dump_file)
+    fprintf (dump_file, "****success inc chain of %u, deleting add %d\n",
+	     insns.length (), INSN_UID (add));
+  delete_insn (add);
+  return true;
+}
+
 /* Discover auto-inc auto-dec instructions.  */
 
