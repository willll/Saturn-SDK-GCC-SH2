host: fix build errors with recent host compilers and C libraries

- collect2.c: open() with O_CREAT needs a mode; glibc's fortified open()
  refuses to compile the call without it.
- obstack.h: "*((void **) p)++ = x" (a cast used as lvalue) was removed in
  GCC 4.0; store, then advance the pointer.
- Makefile.in: do not build or install the info manuals.  The texinfo 3.12
  makeinfo that 2.95 builds garbles node names when GCC 15 compiles it at
  -O2, and with MAKEINFO=true (needed by binutils on hosts without
  makeinfo) install-info fails on the missing files.  The man pages are
  still installed.

diff --git a/gcc-2.95.3/gcc/collect2.c b/gcc-2.95.3/gcc/collect2.c
index 153ac6f..1e00834 100644
--- a/gcc-2.95.3/gcc/collect2.c
+++ b/gcc-2.95.3/gcc/collect2.c
@@ -1759,7 +1759,7 @@ collect_execute (prog, argv, redir)
   if (redir)
     {
       /* Open response file.  */
-      redir_handle = open (redir, O_WRONLY | O_TRUNC | O_CREAT);
+      redir_handle = open (redir, O_WRONLY | O_TRUNC | O_CREAT, 0666);
 
       /* Duplicate the stdout and stderr file handles
 	 so they can be restored later.  */
