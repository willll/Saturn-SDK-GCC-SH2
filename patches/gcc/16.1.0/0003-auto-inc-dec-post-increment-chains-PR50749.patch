+/* A register known to hold the chain register's value plus OFFSET: the
+   register itself, or a pseudo set by "T = REG + OFFSET" (such as the
+   base expand makes for a displacement the target cannot encode).  DEF
+   is that set, or NULL for REG itself.  */
+
+struct chain_base
+{
+  rtx reg;
+  HOST_WIDE_INT offset;
+  rtx_insn *def;
+  bool valid;
+};
+
+/* Return the location of the MEM in *LOC whose address is B or
+   B + CONST_INT for one of the valid BASES, and set *IDX to that base,
+   or return NULL.  Like find_mem, refuse bit-field MEMs.  */
+
+static rtx *
+find_chain_mem (rtx *loc, const vec<chain_base> &bases, unsigned *idx)
+{
+  rtx x = *loc;
+  enum rtx_code code = GET_CODE (x);
+  const char *const fmt = GET_RTX_FORMAT (code);
+
+  if (code == MEM)
+    {
+      rtx b = XEXP (x, 0);
+      if (GET_CODE (b) == PLUS && CONST_INT_P (XEXP (b, 1)))
+	b = XEXP (b, 0);
+      if (REG_P (b))
+	for (unsigned i = 0; i < bases.length (); i++)
+	  if (bases[i].valid && REGNO (b) == REGNO (bases[i].reg))
+	    {
+	      *idx = i;
+	      return loc;
+	    }
+    }
+  if (code == SIGN_EXTRACT || code == ZERO_EXTRACT)
+    return NULL;
+
+  for (int i = GET_RTX_LENGTH (code) - 1; i >= 0; i--)
+    if (fmt[i] == 'e')
+      {
+	if (rtx *r = find_chain_mem (&XEXP (x, i), bases, idx))
+	  return r;
+      }
+    else if (fmt[i] == 'E')
+      for (int j = XVECLEN (x, i) - 1; j >= 0; j--)
+	if (rtx *r = find_chain_mem (&XVECEXP (x, i, j), bases, idx))
+	  return r;
+  return NULL;
+}
+
+/* PR 50749.  The forms above pair one access with one increment, so
+
+     ... *(r + 0) ... *(r + s1) ... *(r + s1 + s2) ...  a = r + s1 + s2 + s3
+     ... *(r - s1) ... *(r - s1 - s2) ...  a = r - s1 - s2
+
+   (s1, s2, s3 being the access sizes, as ivopts, unrolling and code
+   like "*p++; *p++; return p;" produce) kept reg + disp addressing plus
+   the add.  If ADD is such an increment and the accesses before it form
+   such a chain, turn them into post-increments (C > 0) or
+   pre-decrements (C < 0) and delete ADD.  The accesses may also go
+   through a pseudo set to r + k (expand makes one for displacements
+   the target cannot encode, e.g. negative ones on SH).  When a is not
+   r, a = r is inserted before the chain and a is incremented instead,
+   so r keeps its value.  Return true on success.  */
+
+static bool
+merge_inc_chain (rtx_insn *add, basic_block bb)
+{
+  rtx set = single_set (add);
+  if (!set)
+    return false;
+  rtx dest = SET_DEST (set), src = SET_SRC (set);
+  if (GET_CODE (src) != PLUS || !REG_P (XEXP (src, 0))
+      || !CONST_INT_P (XEXP (src, 1)) || INTVAL (XEXP (src, 1)) == 0)
+    return false;
+  rtx reg = XEXP (src, 0);
+  HOST_WIDE_INT c = INTVAL (XEXP (src, 1));
+  bool post = c > 0;
+  if ((post ? !HAVE_POST_INCREMENT : !HAVE_PRE_DECREMENT)
+      || !REG_P (dest) || HARD_REGISTER_P (dest) || HARD_REGISTER_P (reg)
+      || GET_MODE (dest) != GET_MODE (reg))
+    return false;
+  /* COPY: increment DEST, a copy of REG, and leave REG alone.  */
+  bool copy = REGNO (dest) != REGNO (reg);
+
+  /* shortcut: only look this many insns back, raise it if chains in big
+     blocks are missed.  */
+  const int window = 64;
+
+  /* Find the pseudos set to REG + K whose value still holds at ADD:
+     REG unchanged since, and the set the last one of that pseudo.  */
+  auto_vec<chain_base, 4> bases;
+  bases.safe_push ({ reg, 0, NULL, true });
+  int budget = window;
+  for (rtx_insn *insn = PREV_INSN (add);
+       insn != PREV_INSN (BB_HEAD (bb)) && --budget >= 0 && bases.length () < 4;
+       insn = PREV_INSN (insn))
+    {
+      if (!NONDEBUG_INSN_P (insn))
+	continue;
+      if (reg_set_p (reg, insn))
+	break;
+      rtx s = single_set (insn);
+      if (!s || !REG_P (SET_DEST (s)) || HARD_REGISTER_P (SET_DEST (s)))
+	continue;
+      rtx t = SET_DEST (s), ts = SET_SRC (s);
+      if (REGNO (t) == REGNO (reg) || REGNO (t) == REGNO (dest)
+	  || GET_MODE (t) != GET_MODE (reg))
+	continue;
+      HOST_WIDE_INT k;
+      if (REG_P (ts) && REGNO (ts) == REGNO (reg))
+	k = 0;
+      else if (GET_CODE (ts) == PLUS && REG_P (XEXP (ts, 0))
+	       && REGNO (XEXP (ts, 0)) == REGNO (reg)
+	       && CONST_INT_P (XEXP (ts, 1)))
+	k = INTVAL (XEXP (ts, 1));
+      else
+	continue;
+      bool later_set = false;
+      for (rtx_insn *i = NEXT_INSN (insn); i != add && !later_set;
+	   i = NEXT_INSN (i))
+	later_set = INSN_P (i) && reg_set_p (t, i);
+      if (!later_set)
+	bases.safe_push ({ t, k, insn, true });
+    }
+
+  /* Walk back from ADD.  EXPECT is where (post) the next earlier access
+     must end, or (pre) where it must start, relative to REG.  P records
+     REG's (or DEST's) value relative to REG after each access.  In place,
+     every use of REG up to the start of the chain would see the changed
+     value, so each must be a chain MEM; with COPY, DEST must not appear
+     there instead.  */
+  auto_vec<rtx_insn *, 8> insns;
+  auto_vec<rtx *, 8> locs;
+  auto_vec<HOST_WIDE_INT, 8> ps;
+  bool via_alias = false;
+  HOST_WIDE_INT expect = c;
+  budget = window;
+  for (rtx_insn *insn = PREV_INSN (add); expect != 0; insn = PREV_INSN (insn))
+    {
+      if (insn == PREV_INSN (BB_HEAD (bb)) || --budget < 0)
+	return false;
+      if (!INSN_P (insn))
+	continue;
+      if (copy && reg_mentioned_p (dest, insn))
+	return false;
+      if (DEBUG_INSN_P (insn))
+	continue;
+      /* A base pseudo's value holds only after its set.  */
+      for (unsigned i = 1; i < bases.length (); i++)
+	if (bases[i].def == insn)
+	  bases[i].valid = false;
+      if (reg_set_p (reg, insn))
+	return false;
+
+      unsigned idx = 0;
+      rtx *loc = find_chain_mem (&PATTERN (insn), bases, &idx);
+      if (!loc)
+	{
+	  if (copy || !reg_mentioned_p (reg, PATTERN (insn)))
+	    {
+	      /* Such a note would describe the old value of REG.  */
+	      rtx note = find_reg_equal_equiv_note (insn);
+	      if (!copy && note && reg_mentioned_p (reg, XEXP (note, 0)))
+		return false;
+	      continue;
+	    }
+	  return false;
+	}
+      if (CALL_P (insn)
+	  || (JUMP_P (insn) && targetm.lra_p ())
+	  || asm_noperands (PATTERN (insn)) >= 0
+	  || reg_set_p (bases[idx].reg, insn))
+	return false;
+      /* In place, REG may appear only as this MEM's base.  */
+      if (!copy
+	  && count_occurrences (PATTERN (insn), reg, 1) != (idx == 0 ? 1 : 0))
+	return false;
+
+      rtx mem = *loc, addr = XEXP (mem, 0);
+      HOST_WIDE_INT size;
+      HOST_WIDE_INT off = (bases[idx].offset
+			   + (GET_CODE (addr) == PLUS
+			      ? INTVAL (XEXP (addr, 1)) : 0));
+      if (!GET_MODE_SIZE (GET_MODE (mem)).is_constant (&size)
+	  || GET_MODE (reg) != targetm.addr_space.address_mode
+				 (MEM_ADDR_SPACE (mem)))
+	return false;
+      if (post ? (off + size != expect || off < 0)
+	       : (off != expect || off + size > 0))
+	return false;
+      insns.safe_push (insn);
+      locs.safe_push (loc);
+      ps.safe_push (post ? off + size : off);
+      via_alias |= idx != 0;
+      expect = post ? off : off + size;
+    }
+
+  /* A single in-place access through REG is the plain FORM_POST_INC
+     (or FORM_PRE_DEC) case.  */
+  if ((insns.length () < 2 && !copy && !via_alias)
+      || !dbg_cnt (auto_inc_dec))
+    return false;
+
+  rtx inc = copy ? dest : reg;
+  bool speed = optimize_bb_for_speed_p (bb);
+  int old_cost = set_rtx_cost (set, speed);
+  int new_cost = copy ? set_rtx_cost (gen_rtx_SET (dest, reg), speed) : 0;
+  for (unsigned i = 0; i < insns.length (); i++)
+    {
+      rtx mem = *locs[i];
+      rtx new_mem = replace_equiv_address_nv
+		      (mem, post ? gen_rtx_POST_INC (GET_MODE (inc), inc)
+				 : gen_rtx_PRE_DEC (GET_MODE (inc), inc));
+      old_cost += set_src_cost (mem, GET_MODE (mem), speed);
+      new_cost += set_src_cost (new_mem, GET_MODE (mem), speed);
+      validate_change (insns[i], locs[i], new_mem, true);
+    }
+  /* The target may lack the form for some accesses (on SH, post-increment
+     stores and pre-decrement loads); then the group fails as a whole.  */
+  if (new_cost > old_cost || !apply_change_group ())
+    {
+      cancel_changes (0);
+      if (dump_file)
+	fprintf (dump_file, "inc chain of %u at %d failed\n",
+		 insns.length (), INSN_UID (add));
+      return false;
+    }
+
+  /* INSNS is in reverse order.  Between access I and the next one (or
+     ADD), INC holds REG's old value plus PS[I]: in place, rebase debug
+     uses of REG there.  With COPY, REG is unchanged and DEST did not
+     appear before ADD.  */
+  rtx_insn *next = add;
+  for (unsigned i = 0; i < insns.length (); i++)
+    {
+      rtx_insn *insn = insns[i];
+      add_reg_note (insn, REG_INC, inc);
+      if (rtx note = find_reg_equal_equiv_note (insn))
+	if (reg_mentioned_p (inc, XEXP (note, 0)))
+	  remove_note (insn, note);
+      if (!copy && MAY_HAVE_DEBUG_BIND_INSNS)
+	propagate_for_debug (insn, next, reg,
+			     plus_constant (GET_MODE (reg), reg, -ps[i]), bb);
+      next = insn;
+    }
+  if (copy)
+    emit_insn_before (gen_move_insn (dest, reg), insns.last ());
+
+  if (dump_file)
+    fprintf (dump_file, "****success %s chain of %u%s%s, deleting add %d\n",
+	     post ? "inc" : "dec", insns.length (),
+	     copy ? ", copy" : "", via_alias ? ", via base" : "",
+	     INSN_UID (add));
+  delete_insn (add);
+  return true;
+}
+
