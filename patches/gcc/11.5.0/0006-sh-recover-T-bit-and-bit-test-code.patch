+(define_insn_and_split "*cmp<gtu_leu:code>_<SZ_EXTEND:code>_<QIHI:mode>_pow2m1"
+  [(set (reg:SI T_REG)
+	(gtu_leu:SI (SZ_EXTEND:SI (match_operand:QIHI 0 "arith_reg_operand"))
+		    (match_operand:SI 1 "const_int_operand")))]
