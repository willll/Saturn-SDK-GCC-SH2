 /* Result value of sh_split_treg_set_expr.  Contains the first insn emitted
--- a/gcc-11.5.0/gcc/config/sh/sh.c
+++ b/gcc-11.5.0/gcc/config/sh/sh.c
@@ -12310,6 +12310,62 @@
   return result >= 0;
 }
 
+/* Return true before the split1 pass: patterns that only split1 can split
+   must not match later, when IRA may substitute constants into insns.  */
+bool
+sh_pre_split1_p (void)
+{
+  return can_create_pseudo_p ()
+	 && !(cfun->curr_properties & PROP_rtl_split_insns);
+}
+
+/* Split T = EXT (X) >u C (CODE == GTU) or T = EXT (X) <=u C (CODE == LEU),
+   where X is a QImode or HImode register, EXT (EXT_CODE) a zero or sign
+   extension and C = 2^k - 1 is below the sign bit of X.  EXT (X) <=u C
+   is (X & ~C & mode mask) == 0, a tst on the unextended X.  The inverted
+   tst of the GTU case costs nothing only when a conditional branch uses
+   T (sh_treg_combine then inverts the branch); otherwise extend X and use
+   cmp/hi.  */
+void
+sh_split_cmpu_pow2m1 (rtx_code code, rtx_code ext_code, rtx x, rtx c,
+		      rtx_insn *curr_insn)
+{
+  machine_mode mode = GET_MODE (x);
+  HOST_WIDE_INT cval = INTVAL (c);
+  rtx t = get_t_reg_rtx ();
+
+  /* The first insn of the basic block after CURR_INSN that uses T.  */
+  rtx_insn *use = NULL;
+  for (rtx_insn *i = NEXT_INSN (curr_insn);
+       i != NULL && !NOTE_INSN_BASIC_BLOCK_P (i) && !LABEL_P (i);
+       i = NEXT_INSN (i))
+    if (NONDEBUG_INSN_P (i))
+      {
+	if (reg_referenced_p (t, PATTERN (i)))
+	  {
+	    use = i;
+	    break;
+	  }
+	if (reg_set_p (t, i) || CALL_P (i))
+	  break;
+      }
+
+  if (code == LEU || (use != NULL && any_condjump_p (use)))
+    {
+      HOST_WIDE_INT mask = ~cval & GET_MODE_MASK (mode);
+      emit_insn (gen_tstsi_t (simplify_gen_subreg (SImode, x, mode, 0),
+			      gen_int_mode (mask, SImode)));
+      if (code == GTU)
+	emit_insn (gen_nott (t));
+    }
+  else
+    {
+      rtx ext = gen_reg_rtx (SImode);
+      emit_insn (gen_rtx_SET (ext, gen_rtx_fmt_e (ext_code, SImode, x)));
+      emit_insn (gen_cmpgtusi_t (ext, force_reg (SImode, c)));
+    }
+}
+
 /* Returns true when recog of a 'treg_set_expr' is currently in progress.
    This can be used as a condition for insn/split patterns to allow certain
    T bit setting patters only to be matched as sub expressions of other
