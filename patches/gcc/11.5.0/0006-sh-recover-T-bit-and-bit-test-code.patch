+})
+
+(define_insn_and_split "*cmp<gtu_leu:code>_<QIHI:mode>_pow2m1"
+  [(set (reg:SI T_REG)
+	(gtu_leu:SI (match_operand:QIHI 0 "arith_reg_operand")
+		    (match_operand:SI 1 "const_int_operand")))]
+  "TARGET_SH1 && sh_pre_split1_p ()
+   && INTVAL (operands[1]) > 0
+   && INTVAL (operands[1]) < (<QIHI:MODE>mode == QImode ? 0x7F : 0x7FFF)
+   && exact_log2 (INTVAL (operands[1]) + 1) > 0"
+  "#"
+  "&& 1"
+  [(const_int 0)]
+{
+  /* An unsigned compare in the narrow mode is one of zero extended values.  */
+  sh_split_cmpu_pow2m1 (<gtu_leu:CODE>, ZERO_EXTEND, operands[0],
+			operands[1], curr_insn);
+  DONE;
+})
