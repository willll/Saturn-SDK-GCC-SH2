+;; C - T and C + T with a constant C, which combine gets from conditionals
+;; that GCC 9 and later turn into arithmetic, such as
+;; "a >= b ? 0x7FFFFFFF : 0x80000000" (-(int) cond ^ 0x80000000, C - T) and
+;; "a != b ? 0x80000000 : 0x7FFFFFFF" (-(int) cond ^ 0x7FFFFFFF, C + T).
+;; negc computes 0 - Rm - T and addc Rn + Rm + T.  When the T bit
+;; expression ends with a nott, drop it and use the other insn.
+;; C - T with C = 0 is a single subc already, and 1 - T is the negated T.
+(define_insn_and_split "*negc_const"
+  [(set (match_operand:SI 0 "arith_reg_dest")
+	(minus:SI (match_operand:SI 1 "const_int_operand")
+		  (match_operand 2 "treg_set_expr")))
+   (clobber (reg:SI T_REG))]
+  "TARGET_SH1 && can_create_pseudo_p ()
+   && INTVAL (operands[1]) != 0 && INTVAL (operands[1]) != 1"
+  "#"
+  "&& 1"
+  [(const_int 0)]
+{
+  sh_treg_insns ti = sh_split_treg_set_expr (operands[2], curr_insn);
+  if (ti.remove_trailing_nott ())
+    /* C - (1 - T) = (C - 1) + T  */
+    emit_insn (gen_addc (operands[0], force_reg (SImode, const0_rtx),
+			 force_reg (SImode,
+				    gen_int_mode (INTVAL (operands[1]) - 1,
+						  SImode))));
+  else
+    /* C - T = 0 - (-C) - T  */
+    emit_insn (gen_negc (operands[0],
+			 force_reg (SImode,
+				    gen_int_mode (-INTVAL (operands[1]),
+						  SImode))));
+  DONE;
+})
+
+;; -T ^ 0x7FFFFFFF = 0x7FFFFFFF + T.  (-T ^ 0x80000000 is canonicalized
+;; to 0x80000000 - T, see above.)
+(define_insn_and_split "*addc_const_xor"
+  [(set (match_operand:SI 0 "arith_reg_dest")
+	(xor:SI (neg:SI (match_operand 1 "treg_set_expr"))
+		(const_int 2147483647)))
+   (clobber (reg:SI T_REG))]
+  "TARGET_SH1 && can_create_pseudo_p ()"
+  "#"
+  "&& 1"
+  [(const_int 0)]
+{
+  /* negc needs no zero register: for an ordered comparison of two
+     registers, set T to the opposite comparison (just as cheap) and use
+     0x7FFFFFFF + X = 0x80000000 - !X.  */
+  rtx x = operands[1];
+  rtx_code code = GET_CODE (x);
+  rtx_code inv = code == GT ? GE : code == GE ? GT
+		 : code == GTU ? GEU : code == GEU ? GTU : UNKNOWN;
+  if (inv != UNKNOWN
+      && GET_MODE (XEXP (x, 0)) == SImode
+      && arith_reg_operand (XEXP (x, 0), SImode)
+      && arith_reg_operand (XEXP (x, 1), SImode))
+    x = gen_rtx_fmt_ee (inv, SImode, XEXP (x, 1), XEXP (x, 0));
+  else
+    inv = UNKNOWN;
+
+  sh_treg_insns ti = sh_split_treg_set_expr (x, curr_insn);
+  /* T = !X if inverted here xor if a trailing nott was dropped.  */
+  if ((inv != UNKNOWN) != ti.remove_trailing_nott ())
+    /* 0x7FFFFFFF + (1 - T) = 0x80000000 - T  */
+    emit_insn (gen_negc (operands[0],
+			 force_reg (SImode, gen_int_mode (0x80000000, SImode))));
+  else
+    emit_insn (gen_addc (operands[0], force_reg (SImode, const0_rtx),
+			 force_reg (SImode, GEN_INT (0x7FFFFFFF))));
+  DONE;
+})
+
